DJANGO_SECRET_KEY=replace-me-with-a-50-char-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_TIME_ZONE=UTC

# Hidden dashboard + admin prefixes (change before going live!)
COMPANY_DASHBOARD_URL=control-panel-xyz/
DJANGO_ADMIN_URL=admin/

COMPANY_NAME=BuildCorp
SITE_BASE_URL=http://localhost:8000
DEFAULT_FROM_EMAIL=no-reply@duracast.example
LEAD_NOTIFICATION_EMAIL=hello@duracast.example

# PostgreSQL (leave POSTGRES_DB empty to use SQLite)
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432